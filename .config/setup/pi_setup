#!/bin/sh
# Raspberry Pi / Minimal Server Setup
# Bare-clones the `pi` branch, which carries minimal .zshrc/.vimrc/.gitconfig
# at the same top-level paths the full setup uses on macOS.

set -e

log() { printf '\033[0;36m%s\033[0m\n' "$1"; }

log "Installing packages via apt..."
sudo apt update
sudo apt install -y zsh git curl fzf bat neovim

log "Installing Oh My Zsh..."
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
else
    log "Oh My Zsh already installed, skipping"
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

log "Installing zsh-autosuggestions and zsh-syntax-highlighting..."
[ -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ] || \
    git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
[ -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ] || \
    git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"

log "Cloning dotfiles (pi branch)..."
[ -d "$HOME/.dotfiles.git" ] || \
    git clone --bare -b pi git@github.com:rusito-23/.dotfiles.git "$HOME/.dotfiles.git"
dot() { git --git-dir="$HOME/.dotfiles.git" --work-tree="$HOME" "$@"; }
dot config --local status.showUntrackedFiles no

log "Checking out dotfiles (backing up any conflicting files)..."
mkdir -p "$HOME/.dotfiles-backup"
if ! dot checkout pi 2>/tmp/dot_checkout_err; then
    grep -E '^\s+\.' /tmp/dot_checkout_err | while IFS= read -r f; do
        f=$(echo "$f" | xargs)
        mkdir -p "$HOME/.dotfiles-backup/$(dirname "$f")"
        mv "$HOME/$f" "$HOME/.dotfiles-backup/$f"
    done
    dot checkout pi
fi
rm -f /tmp/dot_checkout_err

log "Switching default shell to zsh..."
chsh -s "$(which zsh)"

log "Set your git identity with: git config --global user.name/user.email"
log "Done! Restart your shell or run: exec zsh"
